# Optional properties belonging to flschoolcalendar.com.
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# Public Turnstile site key: needed at build time for the static pages.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only correction settings. Configure these as Cloudflare Worker secrets.
NUXT_CORRECTIONS_RESEND_API_KEY=
NUXT_CORRECTIONS_FROM=
NUXT_CORRECTIONS_TO=corrections@flschoolcalendar.com
NUXT_CORRECTIONS_TURNSTILE_SECRET=
NUXT_CORRECTIONS_TURNSTILE_HOSTS=flschoolcalendar.com,www.flschoolcalendar.com
# Enable only when requests arrive through Cloudflare; forwards CF-Connecting-IP.
NUXT_CORRECTIONS_TRUST_PROXY=false
